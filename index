<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mapa de Bases - GTA San Andreas</title>

  <!-- CSS de Leaflet -->
  <link 
    rel="stylesheet" 
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" 
  />

  <style>
    body, html {
      margin: 0;
      padding: 0;
      height: 100%;
      width: 100%;
      background-color: #000;
    }

    #map {
      width: 100vw;
      height: 100vh;
    }
  </style>
</head>
<body>

  <div id="map"></div>

  <!-- JS de Leaflet -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script>
    // 1. Configuración de dimensiones del mapa (Coordenadas in-game de GTA San Andreas: -3000 a +3000)
    const bounds = [[-3000, -3000], [3000, 3000]];

    // 2. Inicialización del mapa en sistema CRS Simple (Plano 2D)
    const map = L.map('map', {
      crs: L.CRS.Simple,
      minZoom: -2,
      maxZoom: 3,
      zoomControl: true
    });

    // 3. Capa de la imagen del mapa de GTA SA
    // Puedes usar directamente la imagen completa del repositorio o alojarla localmente
    const mapImageUrl = 'https://raw.githubusercontent.com/interactive-game-maps/grand_theft_auto_san_andreas/master/gtasa-satellite.jpg';
    
    L.imageOverlay(mapImageUrl, bounds).addTo(map);
    map.fitBounds(bounds);

    // 4. Lista con tus 37 marcadores de bases
    // Cambia X (Eje Este/Oeste) y Y (Eje Norte/Sur) por las coordenadas in-game reales.
    const bases = [
      { id: 1, nombre: "Base Grove Street", x: 2493, y: -1670, descripcion: "Base principal de operaciones" },
      { id: 2, nombre: "Base Aeropuerto LV", x: 1600, y: 1600, descripcion: "Pista de aterrizaje" },
      { id: 3, nombre: "Base Área 69", x: 210, y: 1900, descripcion: "Instalación de alta seguridad" },
      // ... Agrega aquí el resto hasta completar las 37
    ];

    // 5. Conversión de coordenadas de GTA SA a Leaflet [Y, X]
    bases.forEach(base => {
      // Leaflet toma [latitud, longitud], en un plano simple equivale a [Y, X]
      const marker = L.marker([base.y, base.x]).addTo(map);

      // Popup informativo al hacer clic en la base
      marker.bindPopup(`
        <div style="font-family: sans-serif;">
          <h3 style="margin: 0 0 5px 0;">${base.nombre}</h3>
          <p style="margin: 0; font-size: 13px;">${base.descripcion}</p>
          <small style="color: #666;">Coords: (${base.x}, ${base.y})</small>
        </div>
      `);
    });

    // 6. Utilidad para desarrollo: muestra las coordenadas al hacer clic en el mapa
    map.on('click', function(e) {
      const x = Math.round(e.latlng.lng);
      const y = Math.round(e.latlng.lat);
      console.log(`Coordenada seleccionada: X: ${x}, Y: ${y}`);
    });
  </script>

</body>
</html>
